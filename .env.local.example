# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon connection string, from your Neon project dashboard -> Connection Details.
# Use the "pooled" connection string for the app; either works for migrations.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Random secret for NextAuth session encryption. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Vercel Blob token, from Vercel project -> Storage -> Blob -> .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# Gmail account used to send job reminder emails (via an App Password, not
# your login password): https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Shared secret the reminder cron job must present. Generate with:
#   openssl rand -base64 24
CRON_SECRET=""

# Public URL of the deployed app, used to build links inside reminder emails.
APP_URL="https://your-app.vercel.app"
