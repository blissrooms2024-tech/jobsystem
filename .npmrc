# next-auth declares an optional peer dependency on nodemailer@^7||^8 (only
# used by its Email/magic-link provider, which this app doesn't use — we
# only use the Credentials provider). We pin nodemailer@9.x at the root for
# our own reminder-email code (src/lib/mailer.ts) to get a security fix that
# isn't backported to 8.x. That version mismatch makes npm's default strict
# peer resolution fail the install; legacy-peer-deps restores npm 6 behavior
# (peer deps are advisory, not install-blocking) so the build doesn't break
# over a peer range we deliberately don't satisfy.
legacy-peer-deps=true
